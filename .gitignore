# Subidas de la aplicación (imágenes y otros ficheros de usuario)
/uploads/

# Fotos estáticas / migradas bajo resources (no versionar binarios)
/src/main/resources/static/uploads/

# Copia en salida de compilación (Maven copia resources aquí)
target/classes/static/uploads/

# Empaquetado de Maven: son cientos de MB y GitHub rechaza los que pasan de 100
target/*.jar
target/*.jar.original
target/*.war
